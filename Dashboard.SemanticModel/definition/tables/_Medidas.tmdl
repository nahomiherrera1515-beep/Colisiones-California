table _Medidas
	lineageTag: 0b2b21c9-c469-4ab9-965f-ab923fce5517

	measure Tasa_Mortalidad_100k = DIVIDE(SUM(tabla_tasas[fallecidos]), SUM(tabla_tasas[habitantes]), 0) * 100000
		lineageTag: 9a190964-fc37-48e3-91eb-1c4af9a8e20e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Prop_Colisiones_Fatal =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(hechos_colisiosns), hechos_colisiosns[con_fallecido] = "True"),
			    COUNTROWS(hechos_colisiosns),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e515be47-460c-457b-b0d0-b36073f2d651

	measure Total_Colisiones = COUNTROWS(hechos_colisiosns)
		formatString: 0
		lineageTag: d66f7c63-037c-48b1-9444-01cb85c54556

	measure Total_Fallecidos = CALCULATE(COUNTROWS(hechos_colisiosns), hechos_colisiosns[con_fallecido] = "true")
		formatString: 0
		lineageTag: 9b21e163-035b-409a-82b0-73bbf2a2b1c9

	measure Porcentaje_Total =
			
			DIVIDE(
			    [Total_Colisiones],
			    CALCULATE([Total_Colisiones], ALL(dim_superficie)),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e88eea9b-ff8a-4138-8dd3-81bd96f75361

	measure '% Choques Graves' = ```
			
			VAR TotalChoques = COUNTROWS(hechos_colisiosns)
			VAR ChoquesGraves = 
			    CALCULATE(
			        COUNTROWS(hechos_colisiosns),
			        hechos_colisiosns[es_grave] = "true"
			    )
			RETURN
			    DIVIDE(ChoquesGraves, TotalChoques, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4e9e8afc-9a34-4524-8e35-9d2a628acd33

	measure 'Total Víctimas Ocupantes' =
			
			CALCULATE(
			    COUNTROWS(hechos_victimas),
			    hechos_victimas[es_ocupante] = "true"
			)
		formatString: 0
		lineageTag: bba2d6e2-c379-4a3e-92d2-47fe3dcc4947

	measure '% Víctimas Graves o Fatales' = ```
			
			VAR TotalVictimas = [Total Víctimas Ocupantes]
			VAR VictimasGraves = 
			    CALCULATE(
			        [Total Víctimas Ocupantes],
			        dim_kabco[kabco] IN {"K", "A"}
			    )
			RETURN
			    DIVIDE(VictimasGraves, TotalVictimas, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 41e69ac7-28b3-434e-9f7b-225254c0446c

	column 'Columna 1'
